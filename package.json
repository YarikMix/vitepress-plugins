{
  "name": "vitepress-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p scripts && tsc --noEmit -p tests/site",
    "test": "bun run --filter '*' test && bun test scripts/*.test.ts",
    "test:packages": "bun run check:packages",
    "check:site": "bun scripts/check-site.ts",
    "check:packages": "bun scripts/check-packages.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "@playwright/test": "^1.63.0",
    "vitepress": "2.0.0-alpha.21",
    "vue": "3.5.43",
    "mermaid": "^11",
    "@wely6743/vitepress-mermaid-renderer": "workspace:*",
    "@wely6743/vitepress-module-graph": "workspace:*",
    "@wely6743/vitepress-diagram-viewer": "workspace:*"
  }
}
